{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/planner/tools/cli.ts\" hook session-start 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/planner/tools/cli.ts\" hook prompt 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
